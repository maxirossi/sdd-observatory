# ────────── Postgres ──────────
POSTGRES_DB=ssdoffice
POSTGRES_USER=ssdoffice
POSTGRES_PASSWORD=ssdoffice
POSTGRES_PORT=5433

# ────────── Backend ──────────
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://ssdoffice:ssdoffice@postgres:5432/ssdoffice
APP_ENV=development
LOG_LEVEL=INFO
# Default privacy mode for captured payloads:
#   metadata_only      → solo size/latency/status. Prompts NUNCA se persisten.
#   sanitized_payload  → si capture_payload del provider está on, se persiste sanitizado.
#   raw_local_only     → persiste crudo. NO usar fuera de debug.
PRIVACY_MODE=metadata_only
# TZ del host que genera los logs (VS Code Copilot escribe sin TZ → la usamos para convertir a UTC).
LOG_TIMEZONE=America/Argentina/Buenos_Aires

# ────────── Frontend ──────────
FRONTEND_PORT=5180
VITE_API_URL=http://localhost:8000

# ────────── Project scan target ──────────
# Path del host que se monta dentro del container backend en /workspaces/target.
# Cambiá esto al repo SDD que querés scannear. El fixture de ejemplo es
# sdd-template-lab (https://github.com/<owner>/sdd-template-lab).
SCAN_TARGET_PATH=/path/to/sdd-template-lab
SCAN_TARGET_HOST_PATH=/path/to/sdd-template-lab

# ────────── Claude logs ingest ──────────
# Path del host con los .jsonl de sesiones Claude Code (~/.claude/projects).
# Se monta en /workspaces/claude-logs dentro del container backend.
CLAUDE_LOGS_PATH=${HOME}/.claude/projects
INGEST_WATCH_PATH=/workspaces/claude-logs

# ────────── Copilot logs (VS Code) ──────────
# Path host con ~/.config/Code/logs. Se monta en /workspaces/vscode-logs.
VSCODE_LOGS_PATH=${HOME}/.config/Code/logs
COPILOT_LOGS_PATH=/workspaces/vscode-logs

# ────────── Watch loop ──────────
# El backend ingesta los logs habilitados (claude/copilot/...) cada N segundos.
# Default ON con interval 60s. Bajar a 30 si querés casi-tiempo-real.
INGEST_WATCH_ENABLED=true
INGEST_WATCH_INTERVAL_SECONDS=60
